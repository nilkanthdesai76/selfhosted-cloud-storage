# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cloud_storage?schema=public

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# Redis Configuration (for Bull queues and caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage Configuration
HOT_STORAGE_PATH=./storage/hot
COLD_STORAGE_PATH=./storage/cold
TEMP_UPLOAD_PATH=./temp-uploads
NUM_HOT_SHARDS=4
NUM_COLD_SHARDS=2
COLD_DATA_THRESHOLD_DAYS=30

# Upload Configuration
MAX_FILE_SIZE=5368709120
CHUNK_SIZE=5242880

# Sharing Configuration
SHARE_LINK_EXPIRY_DAYS=7
MAX_DOWNLOADS_DEFAULT=10
